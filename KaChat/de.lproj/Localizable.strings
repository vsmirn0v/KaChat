"Discord" = "Discord";
"Nostr" = "Nostr";
"X" = "X";
"Links" = "Links";
"Primary name" = "Hauptname";
"None" = "Keiner";
"KaChat shows you by your primary name while you own it and it's active; otherwise by your oldest active name, or your address." = "KaChat zeigt dich mit deinem Hauptnamen, solange er dir gehört und aktiv ist; sonst mit deinem ältesten aktiven Namen oder deiner Adresse.";
"Save Profile" = "Profil speichern";
"Saving writes your profile to the chain from your address to itself, for a network fee. Profiles are public." = "Beim Speichern wird dein Profil von deiner Adresse an sich selbst auf die Chain geschrieben, gegen eine Netzwerkgebühr. Profile sind öffentlich.";
"Save your profile?" = "Profil speichern?";
"It's written to the chain for a network fee." = "Es wird gegen eine Netzwerkgebühr auf die Chain geschrieben.";
"Profiles are public and on chain: anyone can read them, and earlier versions stay readable after you change them. It's written for a network fee." = "Profile sind öffentlich und auf der Chain: Jeder kann sie lesen, und frühere Versionen bleiben auch nach Änderungen lesbar. Gespeichert wird gegen eine Netzwerkgebühr.";
"%lld years" = "%lld Jahre";
"No testnet wallet is open." = "Es ist keine Testnet-Wallet geöffnet.";
"This wallet's key does not match its address." = "Der Schlüssel dieser Wallet passt nicht zu ihrer Adresse.";
"%@ is not a valid key (not on the secp256k1 curve)." = "%@ ist kein gültiger Schlüssel (nicht auf der secp256k1-Kurve).";
"The secret for this registration is missing on this device." = "Das Geheimnis für diese Registrierung fehlt auf diesem Gerät.";
"The new owner" = "Der neue Inhaber";
"An expired name can't be listed. Renew it first." = "Ein abgelaufener Name kann nicht angeboten werden. Verlängere ihn zuerst.";
"Your key" = "Dein Schlüssel";
"The buyer" = "Der Käufer";
"%@ is already registered." = "%@ ist bereits registriert.";
