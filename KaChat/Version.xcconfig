// Local, gitignored secrets (API keys). Optional include: missing file is fine - the app
// builds with empty keys and the affected feature (Swap) degrades instead of the build
// breaking. Copy Secrets.xcconfig.example to Secrets.xcconfig and fill in real values.
#include? "Secrets.xcconfig"

// Shared version/build-number source for every target (main app, KaChatNotificationService,
// KaChatShareExtension). App Store Connect requires every bundle in an archive to share the
// exact same CFBundleVersion - before this file existed, each target carried its own
// independent copy of CURRENT_PROJECT_VERSION/MARKETING_VERSION in project.pbxproj, so
// Xcode Cloud's automatic build-number management only updated the main app (whichever target
// it treats as primary), leaving the extensions on a stale value and failing archive
// validation with "The CFBundleVersion of an app extension must match that of its containing
// parent app." Routing all three targets through this single file means any tool that bumps
// the version only has to change it here for it to apply everywhere.
//
// Build numbers are scoped PER VERSION TRAIN by App Store Connect: within one marketing
// version each upload's CFBundleVersion must be strictly greater than the last (that's why
// 3.0 ended at 202607032343 - an early `date +%Y%m%d%H%M` script set the high-water mark and
// restarting low inside the 3.0 train was rejected). Moving to a NEW marketing version resets
// the train, so each train legitimately starts back at build 1 and counts up 2, 3, ... from
// there - 4.0 did, 4.1 did, and 5.0 does the same (4.1 shipped to the App Store 2026-09-15).
// KACHAT_BUILD_NUMBER is the build number that ships. Every target's Info.plist sets
// CFBundleVersion = $(KACHAT_BUILD_NUMBER) explicitly - NOT the usual generated
// $(CURRENT_PROJECT_VERSION) - because Xcode Cloud silently forces CURRENT_PROJECT_VERSION to
// its own counter for archives, and that counter is per product, shared by every workflow,
// and can only go up (an early date-stamp script pushed it to 202607032479, which is where
// the 4.x betas' long build numbers came from). Stamping CURRENT_PROJECT_VERSION ourselves
// in ci_pre_xcodebuild.sh was not enough - Cloud's value still won - so CFBundleVersion now
// reads a setting Cloud has no opinion about. CURRENT_PROJECT_VERSION is kept equal to it
// so Xcode's General tab and agvtool show the same number.
//
// BUMP BOTH FOR EVERY BETA that goes to TestFlight. App Store Connect refuses an upload whose
// build number is not above the last one in the same marketing version, so a forgotten bump
// fails at upload rather than shipping a duplicate.
KACHAT_BUILD_NUMBER = 1
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 5.0

// Required for `agvtool` (used by ci_scripts/ci_pre_xcodebuild.sh) to be able to write
// CURRENT_PROJECT_VERSION for every target - without this, agvtool fails with "not using
// Apple Generic Versioning".
VERSIONING_SYSTEM = apple-generic
