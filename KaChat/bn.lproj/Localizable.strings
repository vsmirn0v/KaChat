/* .kachat: expired names are available to claim */
"Freeing %@ for you..." = "আপনার জন্য %@ মুক্ত করা হচ্ছে...";
"This name expired and wasn't renewed, so anyone can claim it at the normal price. The old owner's bond goes back to them." = "এই নামের মেয়াদ শেষ হয়েছে এবং নবায়ন হয়নি, তাই যে কেউ সাধারণ দামে এটি দাবি করতে পারে। আগের মালিকের জামানত তাঁর কাছে ফিরে যায়।";
"No expired names right now." = "এখন কোনো মেয়াদোত্তীর্ণ নাম নেই।";
"Expired names appear here once .kachat names launch." = ".kachat নাম চালু হলে মেয়াদোত্তীর্ণ নামগুলো এখানে দেখা যাবে।";
"%@ was freed" = "%@ মুক্ত হয়েছে";
"It expired and was cleared from the registry. Your bond is back with you." = "এর মেয়াদ শেষ হয়ে রেজিস্ট্রি থেকে সরানো হয়েছে। আপনার জামানত আপনার কাছে ফিরে এসেছে।";

/* .kachat: name past grace is available to anyone */
"%@ is no longer yours" = "%@ আর আপনার নয়";
"It expired and wasn't renewed, so it's now available to anyone in the marketplace. Your bond comes back to you when someone claims it." = "এর মেয়াদ শেষ হয়েছে এবং নবায়ন হয়নি, তাই এটি এখন মার্কেটপ্লেসে যে কারও জন্য উপলব্ধ। কেউ দাবি করলে আপনার জামানত আপনার কাছে ফিরে আসবে।";

/* .kachat: claims in progress button and busy-network notes */
"Claiming" = "দাবি করা হচ্ছে";
"Names being claimed" = "যে নামগুলো দাবি করা হচ্ছে";
"The network is busy. Your commit is waiting for a block." = "নেটওয়ার্ক ব্যস্ত। আপনার কমিট একটি ব্লকের অপেক্ষায় আছে।";
"The network is busy, so the commit was sent again." = "নেটওয়ার্ক ব্যস্ত, তাই কমিটটি আবার পাঠানো হয়েছে।";

/* Onboarding: import length step and the seed phrase explainer */
"How many words is the seed phrase you're importing?" = "আপনি যে seed phrase ইমপোর্ট করছেন তাতে কয়টি শব্দ আছে?";
"What is this?" = "এটা কী?";
"What is a seed phrase?" = "seed phrase কী?";
"A seed phrase is a list of 12 or 24 ordinary words that works as the master key to your account. Your wallet, your chatting address and your messages all come from it." = "seed phrase হলো ১২ বা ২৪টি সাধারণ শব্দের একটি তালিকা, যা আপনার অ্যাকাউন্টের মূল চাবি হিসেবে কাজ করে। আপনার ওয়ালেট, চ্যাটিং ঠিকানা আর বার্তা সবই এটি থেকে আসে।";
"Anyone who has these words can take everything in your account. If you lose them and lose this device, nobody can get your account back, not even KaChat." = "যার কাছে এই শব্দগুলো থাকবে সে আপনার অ্যাকাউন্টের সবকিছু নিয়ে নিতে পারবে। আপনি এগুলো হারালে আর এই ডিভাইসও হারালে কেউ আপনার অ্যাকাউন্ট ফেরত দিতে পারবে না, KaChat-ও না।";
"Write the words on paper, in order, and keep them somewhere safe and private. Never type them into a website, send them in a chat, or keep them in a screenshot or cloud notes." = "শব্দগুলো ক্রমানুসারে কাগজে লিখে কোনো নিরাপদ ও ব্যক্তিগত জায়গায় রাখুন। কখনো কোনো ওয়েবসাইটে টাইপ করবেন না, চ্যাটে পাঠাবেন না, বা স্ক্রিনশট বা ক্লাউড নোটে রাখবেন না।";
"12 words are already very secure. 24 words add even more protection." = "১২টি শব্দ ইতিমধ্যেই খুব নিরাপদ। ২৪টি শব্দ আরও বেশি সুরক্ষা দেয়।";

