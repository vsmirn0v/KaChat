<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<!-- Export compliance, declared here so App Store Connect stops asking the encryption
	     and France questions on every single TestFlight upload. If KaChat is ever filed for
	     mass-market self-classification with the US BIS, flip this to <true/> and add
	     ITSEncryptionExportComplianceCode with the code Apple issues. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>ChangeNowAPIKey</key>
	<string>$(CHANGENOW_API_KEY)</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock your seed phrase and sign back in, when enabled in Settings.</string>
	<key>NSCameraUsageDescription</key>
	<string>KaChat uses the camera to let you take a photo to send in a chat.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kachat.app.messageFetch</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kachat.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kachat</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
